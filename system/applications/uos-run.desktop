[Desktop Entry]
Type=Application
Name=Avvia con UniOS
Name[en]=Run with UniOS
Comment=Avvia programmi Windows e macOS
Exec=uos run %f
Icon=application-x-executable
Terminal=false
NoDisplay=true
MimeType=application/x-ms-dos-executable;application/x-msdownload;application/vnd.microsoft.portable-executable;application/x-msi;application/x-ms-shortcut;application/x-mach-binary;application/x-executable;application/x-apple-diskimage;application/x-xar;
Actions=install;

[Desktop Action install]
Name=Installa con UniOS
Name[en]=Install with UniOS
Exec=uos install %f
