#!/bin/sh
# Abilita l'architettura i386 per eseguire programmi Windows a 32 bit con Wine.
set -e
# Solo su PC x86_64: su ARM i programmi a 32 bit passano da box64/FEX
[ "$(dpkg --print-architecture)" = amd64 ] || exit 0
dpkg --add-architecture i386
apt-get update
apt-get install -y --no-install-recommends wine32:i386
