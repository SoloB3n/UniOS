#!/bin/sh
# Enable the i386 architecture to run 32-bit Windows programs with Wine.
set -e
# x86_64 PCs only: on ARM, 32-bit programs go through box64/FEX
[ "$(dpkg --print-architecture)" = amd64 ] || exit 0
dpkg --add-architecture i386
apt-get update
apt-get install -y --no-install-recommends wine32:i386
