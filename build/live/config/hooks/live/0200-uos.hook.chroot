#!/bin/sh
# Turn on the UniOS integrations in the generated system.
set -e
# The uos binfmt entries take precedence over Wine's
rm -f /usr/lib/binfmt.d/wine.conf
update-desktop-database -q /usr/share/applications || true
# Open Windows/macOS executables with the dispatcher, for every user
mkdir -p /etc/xdg
cat >> /etc/xdg/mimeapps.list <<'MIME'
[Default Applications]
application/x-ms-dos-executable=uos-run.desktop
application/x-msdownload=uos-run.desktop
application/vnd.microsoft.portable-executable=uos-run.desktop
application/x-msi=uos-run.desktop
application/x-mach-binary=uos-run.desktop
application/x-apple-diskimage=uos-run.desktop
application/x-xar=uos-run.desktop
MIME
# Boot-time self-test, active only with the uos.selftest kernel parameter
systemctl enable uos-selftest.service
# Enable Flathub
flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo || true
