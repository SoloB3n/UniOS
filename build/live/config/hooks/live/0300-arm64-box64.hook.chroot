#!/bin/sh
# ARM64 only: box64 translates x86_64 code on the fly, so x86_64 Linux
# programs run and, with an x86_64 Wine in /opt/uos/wine-x86_64, x86_64
# Windows programs too.
set -e
[ "$(dpkg --print-architecture)" = arm64 ] || exit 0
if ! apt-get install -y --no-install-recommends box64; then
    echo "WARNING: box64 is not available in the archive: add it to config/packages.chroot/" >&2
fi
