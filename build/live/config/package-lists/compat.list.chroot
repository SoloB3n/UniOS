# Compatibility layers
# Windows: Wine (wine32:i386 is added by hook 0100) + prefix management
wine
winetricks
#if ARCHITECTURES amd64
wine64
#endif
fonts-wine
# MS-DOS
dosbox
# CPU emulation for Linux binaries of other architectures (ARM, RISC-V...)
qemu-user
qemu-user-binfmt
binfmt-support
# macOS .dmg images (7z/7zz read DMG, HFS+ and APFS)
7zip
# Universal Linux package formats
flatpak
# Java runtime (Wine downloads wine-mono by itself for .NET programs)
default-jre
