# Strati di compatibilità
# Windows: Wine (wine32:i386 viene aggiunto dall'hook 0100) + gestione prefissi
wine
winetricks
#if ARCHITECTURES amd64
wine64
#endif
fonts-wine
# MS-DOS
dosbox
# Emulazione CPU per binari Linux di altre architetture (ARM, RISC-V...)
qemu-user
qemu-user-binfmt
binfmt-support
# Immagini .dmg di macOS (7z/7zz leggono DMG, HFS+ e APFS)
7zip
# Formati di pacchetto Linux universali
flatpak
# Runtime Java (Wine scarica da sé wine-mono per i programmi .NET)
default-jre
# Requisiti del dispatcher uos
python3
